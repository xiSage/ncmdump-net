@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NcmDecryptService DecryptService

<PageTitle>ncmdump-net</PageTitle>

<div class="app-container">
    <div class="drop-zone" @onclick="TriggerFileInput">
        <div class="drop-zone-content">
            <div class="drop-zone-icon">📁</div>
            <div class="drop-zone-text">拖拽 .ncm 文件到此处</div>
            <div class="drop-zone-subtext">或点击选择文件</div>
        </div>
    </div>

    <InputFile @ref="fileInput" OnChange="OnFileSelected" multiple accept=".ncm" style="display:none" />

    @if (fileItems.Count > 0)
    {
        <div class="file-list">
            @foreach (var item in fileItems)
            {
                <div class="file-item @GetStatusClass(item)">
                    <div class="file-item-header">
                        <span class="status-dot @GetStatusDotClass(item)"></span>
                        <span class="file-name">@item.FileName</span>
                        @if (item.Status == NcmFileItem.NcmStatus.Finished && item.Metadata is { } meta)
                        {
                            <span class="file-meta">@meta.Name - @string.Join(", ", meta.Artist)</span>
                        }
                    </div>
                    <div class="file-item-actions">
                        <span class="file-message @GetMessageClass(item)">@item.Message</span>
                        <div class="file-buttons">
                            @if (item.Status == NcmFileItem.NcmStatus.Finished)
                            {
                                <button class="btn btn-download" @onclick="() => DownloadFile(item)">下载</button>
                            }
                            @if (item.Status == NcmFileItem.NcmStatus.Failed)
                            {
                                <button class="btn btn-retry" @onclick="() => ResetFile(item)">重试</button>
                            }
                            @if (item.Status != NcmFileItem.NcmStatus.Processing)
                            {
                                <button class="btn btn-remove" @onclick="() => RemoveFile(item)">移除</button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="action-bar">
            <button class="btn btn-primary" disabled="@(!canProcess)" @onclick="ProcessFiles">
                @(isReading ? "读取文件..." : canProcess ? "开始处理" : "处理中...")
            </button>
            <div class="action-bar-right">
                <button class="btn" disabled="@(!hasFinishedFiles)" @onclick="ClearFinishedFiles">清除已完成</button>
                <button class="btn" disabled="@(!hasFiles)" @onclick="ClearAllFiles">清除全部</button>
            </div>
        </div>
    }
</div>

@if (isDragOver)
{
    <div class="drag-overlay">
        <div class="drag-overlay-content">
            <div class="drag-overlay-icon">📥</div>
            <div class="drag-overlay-text">释放以添加 .ncm 文件</div>
        </div>
    </div>
}

@code {
    private List<NcmFileItem> fileItems = new();
    private bool isReading = false;
    private bool isProcessing = false;
    private bool isDragOver = false;
    private InputFile? fileInput;
    private (NcmFileItem Item, CancellationTokenSource Cancellation)? currentRead;
    private DotNetObjectReference<Home>? dotNetRef;

    private bool hasFiles => fileItems.Count > 0;
    private bool hasFinishedFiles => fileItems.Any(f => f.Status == NcmFileItem.NcmStatus.Finished);

    // Derived, never assigned: a second writer would let a pick in the middle of a processing run
    // re-enable the button and re-enter ProcessFiles concurrently.
    private bool canProcess => !isReading && !isProcessing;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("ncmApp.init", dotNetRef);
        }
    }

    [JSInvokable]
    public void SetDragOver(bool value)
    {
        isDragOver = value;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task AddDroppedFile(string fileName, byte[] data)
    {
        if (HasFile(fileName)) return;
        fileItems.Add(new NcmFileItem(fileName, data));
        StateHasChanged();
    }

    private bool HasFile(string fileName) => fileItems.Any(f => f.FileName == fileName);

    private async Task TriggerFileInput()
    {
        // A second pick while a read is in flight would swap out the input's FileList that the
        // running read is still copying from.
        if (isReading || fileInput?.Element is not { } element) return;
        await JS.InvokeVoidAsync("ncmApp.clickElement", element);
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        if (isReading) return;

        isReading = true;
        StateHasChanged();

        try
        {
            if (e.FileCount > BrowserFileReader.MaxFileCount)
            {
                var tooMany = new NcmFileItem($"一次最多选择 {BrowserFileReader.MaxFileCount} 个文件");
                tooMany.SetFailed($"已选择 {e.FileCount} 个文件");
                fileItems.Add(tooMany);
                StateHasChanged();
                return;
            }

            var files = e.GetMultipleFiles(BrowserFileReader.MaxFileCount);

            for (var index = 0; index < files.Count; index++)
            {
                var file = files[index];
                if (HasFile(file.Name)) continue;

                if (!file.Name.EndsWith(".ncm", StringComparison.OrdinalIgnoreCase))
                {
                    var rejected = new NcmFileItem(file.Name);
                    rejected.SetFailed("不是 .ncm 文件");
                    fileItems.Add(rejected);
                    StateHasChanged();
                    continue;
                }

                // The entry goes up before the bytes arrive: reading a multi-megabyte file out of
                // the browser takes long enough that waiting for it looks like nothing happened.
                var item = new NcmFileItem(file.Name);
                item.SetReading(0, file.Size);
                fileItems.Add(item);
                StateHasChanged();

                using var cancellation = new CancellationTokenSource();
                currentRead = (item, cancellation);
                try
                {
                    var element = fileInput?.Element ?? throw new InvalidOperationException("文件输入框尚未就绪");
                    var data = await BrowserFileReader.ReadAsync(
                        JS,
                        element,
                        index,
                        file.Size,
                        read =>
                        {
                            item.SetReading(read, file.Size);
                            StateHasChanged();
                        },
                        cancellationToken: cancellation.Token);
                    item.SetData(data);
                }
                catch (OperationCanceledException)
                {
                    // The entry was removed (or the page is going away) while its bytes were
                    // still arriving; nothing to report against an item that is already gone.
                }
                catch (Exception ex)
                {
                    item.SetFailed($"读取文件失败: {ex.Message}");
                }
                finally
                {
                    currentRead = null;
                }

                StateHasChanged();
            }
        }
        finally
        {
            isReading = false;
            StateHasChanged();
        }
    }

    private async Task ProcessFiles()
    {
        if (!canProcess) return;
        isProcessing = true;
        StateHasChanged();

        try
        {
            var pendingItems = fileItems.Where(f => f.Status == NcmFileItem.NcmStatus.Waiting || f.Status == NcmFileItem.NcmStatus.Failed).ToList();

            foreach (var item in pendingItems)
            {
                if (item.RawData == null)
                {
                    item.SetFailed("文件数据不可用，请重新添加");
                    StateHasChanged();
                    continue;
                }

                item.SetProcessing();
                StateHasChanged();

                var result = await NcmDecryptService.DecryptAsync(item.RawData, item.FileName);

                if (result.Success)
                {
                    item.SetFinished(result.Data!, result.FileName!, result.Metadata);
                }
                else
                {
                    item.SetFailed(result.ErrorMessage ?? "未知错误");
                }
                StateHasChanged();
            }
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task DownloadFile(NcmFileItem item)
    {
        if (item.Data == null) return;
        using var stream = new MemoryStream(item.Data);
        var streamRef = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("ncmApp.downloadFileFromStream", item.OutputFileName, streamRef);
    }

    private void RemoveFile(NcmFileItem item)
    {
        CancelReadOf(item);
        fileItems.Remove(item);
        StateHasChanged();
    }

    private void ResetFile(NcmFileItem item)
    {
        item.Reset();
        StateHasChanged();
    }

    private void ClearFinishedFiles()
    {
        fileItems.RemoveAll(f => f.Status == NcmFileItem.NcmStatus.Finished);
        StateHasChanged();
    }

    private void ClearAllFiles()
    {
        CancelReadOf(null);
        fileItems.Clear();
        StateHasChanged();
    }

    private string GetStatusClass(NcmFileItem item) => item.Status switch
    {
        NcmFileItem.NcmStatus.Reading => "status-processing",
        NcmFileItem.NcmStatus.Processing => "status-processing",
        NcmFileItem.NcmStatus.Finished => "status-finished",
        NcmFileItem.NcmStatus.Failed => "status-failed",
        _ => ""
    };

    private string GetStatusDotClass(NcmFileItem item) => item.Status switch
    {
        NcmFileItem.NcmStatus.Waiting => "dot-waiting",
        NcmFileItem.NcmStatus.Reading => "dot-processing",
        NcmFileItem.NcmStatus.Processing => "dot-processing",
        NcmFileItem.NcmStatus.Finished => "dot-finished",
        NcmFileItem.NcmStatus.Failed => "dot-failed",
        _ => ""
    };

    private string GetMessageClass(NcmFileItem item) => item.Status switch
    {
        NcmFileItem.NcmStatus.Failed => "message-error",
        NcmFileItem.NcmStatus.Finished => "message-success",
        _ => ""
    };

    /// <summary>
    ///   Stops the in-flight browser read when its entry — or every entry — is dropped, so a
    ///   removed file stops spending interop round trips instead of finishing into nothing.
    /// </summary>
    private void CancelReadOf(NcmFileItem? item)
    {
        if (currentRead is { } read && (item is null || ReferenceEquals(read.Item, item)))
        {
            read.Cancellation.Cancel();
        }
    }

    public async ValueTask DisposeAsync()
    {
        CancelReadOf(null);
        if (dotNetRef != null)
        {
            try
            {
                await JS.InvokeVoidAsync("ncmApp.dispose");
            }
            catch { }
            dotNetRef.Dispose();
        }
    }
}
